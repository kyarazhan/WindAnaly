QWidget#centralWidget { background: #eef1f5; }
QMainWindow { background: #eef1f5; }

/* ── 顶部一级菜单栏 ── */
QFrame#topBar {
    background: #ffffff;
    border-bottom: 1px solid #d8dce0;
}
QPushButton#updateBtn {
    border: 1px solid #185fa5;
    border-radius: 3px;
    padding: 4px 12px;
    margin: 6px 8px 6px 0;
    font-size: 12px;
    color: #185fa5;
    background: #ffffff;
}
QPushButton#updateBtn:hover {
    background: #e6f1fb;
}
QPushButton#primaryItem {
    border: none;
    border-bottom: 3px solid transparent;
    padding: 10px 16px 7px 16px;
    font-size: 13px;
    font-weight: 500;
    color: #4a5560;
    background: transparent;
    text-align: left;
}
QPushButton#primaryItem:hover {
    color: #1f3b4d;
    background: #f6f9fc;
}
QPushButton#primaryItem:checked {
    color: #185fa5;
    border-bottom: 3px solid #185fa5;
    font-weight: 600;
}

/* ── 二级菜单栏 ── */
QFrame#subBar {
    background: #f4f6f9;
    border-bottom: 1px solid #e0e4e8;
}
QPushButton#secondaryItem {
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 12px 5px 12px;
    font-size: 12px;
    color: #5a6470;
    background: transparent;
    margin: 0;
    text-align: left;
}
QPushButton#secondaryItem:hover {
    color: #185fa5;
    background: #eaf0f7;
}
QPushButton#secondaryItem:checked {
    color: #185fa5;
    border-bottom: 2px solid #3b82c4;
    font-weight: 600;
}

/* 工作区 */
QLabel#moduleTitle {
    font-size: 17px;
    font-weight: 600;
    color: #1f3b4d;
}
QLabel#moduleHint {
    font-size: 12px;
    color: #8a9199;
}

/* 输入区 */
QLabel[fieldLabel="true"] {
    font-size: 12px;
    color: #5a6470;
}
QLineEdit[inputField="true"] {
    background: #fffbe6;
    border: 1px solid #d8dce0;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 13px;
}
QLineEdit[inputField="true"]:focus {
    border: 1px solid #185fa5;
}
QLineEdit[resultField="true"], QLabel[resultField="true"] {
    background: #f2f7fd;
    color: #185fa5;
    border: 1px solid #c5d9ee;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 13px;
}

/* 按钮 */
QPushButton[primaryBtn="true"] {
    background: #185fa5;
    color: #ffffff;
    border: none;
    border-radius: 3px;
    padding: 6px 18px;
    font-size: 13px;
}
QPushButton[primaryBtn="true"]:hover { background: #2a6fb5; }
QPushButton[secondaryBtn="true"] {
    background: transparent;
    color: #185fa5;
    border: 1px solid #185fa5;
    border-radius: 3px;
    padding: 5px 14px;
    font-size: 13px;
}
QPushButton[secondaryBtn="true"]:hover { background: #e6f1fb; }

/* 表格 */
QTableView {
    background: #ffffff;
    border: 1px solid #d8dce0;
    gridline-color: #e4e8ec;
    selection-background-color: #e6f1fb;
    selection-color: #1f3b4d;
    font-size: 12px;
}
QHeaderView::section {
    background: #f0f4f8;
    color: #4a5560;
    border: none;
    border-right: 1px solid #e4e8ec;
    border-bottom: 1px solid #d8dce0;
    padding: 5px 8px;
    font-size: 12px;
}

/* 分组面板（风切变左右板等） */
QGroupBox {
    background: #ffffff;
    border: 1px solid #d8dce0;
    border-radius: 6px;
    margin-top: 12px;
    padding: 10px 12px 12px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #1f3b4d;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    background: #eef1f5;
}

/* 指标卡 */
QFrame[metricCard="true"] {
    background: #e3eaf2;
    border: none;
    border-radius: 6px;
}
QLabel[metricLabel="true"] {
    font-size: 11px;
    color: #6a7480;
}
QLabel[metricValue="true"] {
    font-size: 18px;
    font-weight: 600;
    color: #185fa5;
}

/* 状态栏 */
QStatusBar {
    background: #ffffff;
    color: #8a9199;
    font-size: 11px;
}

/* 菜单栏（数据管理子软件） */
QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #d8dce0;
}
QMenuBar::item {
    padding: 7px 14px;
    font-size: 13px;
    color: #4a5560;
    background: transparent;
}
QMenuBar::item:selected {
    background: #e6f1fb;
    color: #185fa5;
}
QMenu {
    background: #ffffff;
    border: 1px solid #d8dce0;
    padding: 4px 0;
}
QMenu::item {
    padding: 5px 26px 5px 14px;
    font-size: 12px;
    color: #4a5560;
}
QMenu::item:selected {
    background: #185fa5;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #e4e8ec;
    margin: 4px 8px;
}

/* 对话框与表单 */
QDialog { background: #eef1f5; }
QTextBrowser {
    background: #ffffff;
    border: 1px solid #d8dce0;
    border-radius: 4px;
    font-size: 12px;
}
QComboBox {
    background: #ffffff;
    border: 1px solid #d8dce0;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 13px;
}
QComboBox:focus { border: 1px solid #185fa5; }
QCheckBox, QRadioButton {
    font-size: 13px;
    color: #4a5560;
    spacing: 6px;
}
